{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discourse-book-library",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "SEARCH_LIMIT",
      "namespace_id": "92711001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_LIMIT",
      "namespace_id": "92711002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "keep_vars": true
}
